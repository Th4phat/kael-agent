/* Kael TUI stylesheet. Colours are theme variables only (see tui/theme.py),
   so every built-in Textual theme restyles the whole UI. */

Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
}

/* --- layout --------------------------------------------------------- */

#content_container {
    height: 1fr;
}

#chat_area_container {
    width: 80%;
}

#chat_area_container.-full-width {
    width: 100%;
}

#sidebar {
    width: 20%;
    min-width: 26;
    margin-left: 1;
}

#sidebar.-hidden {
    display: none;
}

/* --- chat ----------------------------------------------------------- */

#chat_area {
    height: 1fr;
}

#chat_area > VerticalScroll {
    height: 1fr;
    padding: 0 1 1 0;
    scrollbar-size: 1 1;
}

#welcome {
    padding: 1 2;
}

.chat-placeholder {
    width: 100%;
    height: 100%;
    content-align: center middle;
    color: $text-muted;
    text-style: italic;
}

.user-message {
    border-left: thick $primary;
    padding: 0 1;
    margin: 1 0 0 0;
}

Markdown {
    padding: 0 1;
    margin: 0;
}

.assistant {
    margin-top: 1;
}

.assistant.plain {
    padding: 0 1;
}

MarkdownHeader {
    margin: 1 0 0 0;
}

MarkdownH1 {
    content-align: left middle;
}

Markdown > MarkdownParagraph {
    margin: 0 0 1 0;
}

MarkdownFence {
    margin: 0 0 1 0;
    background: $panel;
}

.reasoning {
    color: $text-muted;
    text-style: italic;
    border-top: solid $border-blurred;
    border-title-color: $text-muted;
    border-title-style: italic;
    padding-top: 0;
}

.folded {
    max-height: 8;
    overflow-y: hidden;
}

.tool-call.folded {
    border-bottom: dashed $border-blurred;
}

.tool-call {
    margin-top: 1;
    padding: 0 1;
}

.tool-call.status-running {
    border-left: outer $warning 60%;
}

.tool-call.status-failed,
.tool-call.status-error {
    border-left: outer $error;
}

.thinking-tool {
    color: $text-muted;
}

#new_messages {
    height: 1;
    width: 100%;
    background: $panel;
    color: $text-accent;
    text-align: center;
    text-style: bold;
}

#new_messages:hover {
    background: $panel-lighten-1;
}

/* --- status row + input --------------------------------------------- */

#status_row {
    height: 1;
    padding: 0 1;
}

#spinner {
    width: 8;
    height: 1;
    margin-right: 1;
    content-align: left middle;
}

#status_text {
    width: 1fr;
    height: 1;
    color: $text-muted;
}

#status_text.error {
    color: $text-error;
}

#chat_input_container {
    height: 3;
    border: round $border-blurred;
    border-title-color: $text-muted;
    layout: horizontal;
}

#chat_input_container:focus-within {
    border: round $primary;
    border-title-color: $primary;
}

#chat_prompt {
    width: auto;
    height: 100%;
    padding: 0 0 0 1;
    color: $text-muted;
}

#chat_input_container:focus-within #chat_prompt {
    color: $primary;
    text-style: bold;
}

#chat_input {
    width: 1fr;
    height: 100%;
    background: transparent;
    border: none;
    padding: 0 1;
}

#chat_input:focus {
    border: none;
}

#chat_input .text-area--cursor-line,
#chat_input:focus .text-area--cursor-line {
    background: transparent;
}

#chat_input > .text-area--placeholder {
    color: $text-disabled;
    text-style: italic;
}

#chat_input > .text-area--cursor {
    background: $primary;
    color: $background;
}

/* --- sidebar -------------------------------------------------------- */

#agents_tree {
    height: 1fr;
    border: round $border-blurred;
    border-title-color: $text-muted;
    padding: 0 1;
    background: transparent;
    scrollbar-size: 1 1;
}

#agents_tree:focus {
    border: round $primary;
    border-title-color: $primary;
}

Tree > .tree--guides {
    color: $border-blurred;
}

Tree > .tree--guides-hover,
Tree > .tree--guides-selected {
    color: $border;
}

#findings {
    height: auto;
    max-height: 12;
    border: round $border-blurred;
    border-title-color: $text-muted;
    background: transparent;
    scrollbar-size: 1 1;
}

#findings:focus {
    border: round $primary;
    border-title-color: $primary;
}

#findings > ListItem {
    padding: 0 1;
    background: transparent;
}

#findings > ListItem > Static {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#stats_scroll {
    height: auto;
    max-height: 8;
    border: round $border-blurred;
    border-title-color: $text-muted;
    scrollbar-size: 0 0;
}

#stats_display,
#elapsed_display {
    padding: 0 1;
    color: $text-muted;
}

/* --- modals --------------------------------------------------------- */

#stop_agent_dialog,
#quit_dialog {
    grid-size: 1;
    grid-gutter: 1;
    grid-rows: auto auto;
    padding: 1 2;
    width: 36;
    height: auto;
    border: round $border;
    background: $panel;
}

#stop_agent_title,
#quit_title {
    text-style: bold;
    text-align: center;
    width: 100%;
}

#stop_agent_buttons,
#quit_buttons {
    grid-size: 2;
    grid-gutter: 1;
    grid-columns: 1fr 1fr;
    width: 100%;
    height: 1;
}

#stop_agent_buttons Button,
#quit_buttons Button {
    height: 1;
    min-height: 1;
    border: none;
    text-style: bold;
    background: transparent;
    color: $text-muted;
}

#stop_agent,
#quit {
    color: $text-error;
}

#stop_agent:hover, #stop_agent:focus,
#quit:hover, #quit:focus {
    background: $error;
    color: $text;
    border: none;
}

#cancel_stop:hover, #cancel_stop:focus,
#cancel:hover, #cancel:focus {
    background: $panel-lighten-2;
    color: $text;
    border: none;
}

#vuln_detail_dialog {
    grid-size: 1;
    grid-gutter: 1;
    grid-rows: 1fr auto;
    padding: 1 2;
    width: 85%;
    max-width: 110;
    height: 85%;
    max-height: 45;
    border: round $border;
    background: $panel;
}

#vuln_detail_scroll {
    height: 1fr;
    scrollbar-size: 1 1;
}

#vuln_detail_content {
    padding: 0 1;
}

#vuln_detail_buttons {
    width: 100%;
    height: auto;
    align: right middle;
    padding-top: 1;
    border-top: solid $border-blurred;
}

#copy_vuln_detail,
#close_vuln_detail {
    width: auto;
    min-width: 10;
    height: auto;
    background: transparent;
    color: $text-muted;
    border: none;
    text-style: none;
    margin: 0 1;
    padding: 0 2;
}

#copy_vuln_detail:hover, #copy_vuln_detail:focus,
#close_vuln_detail:hover, #close_vuln_detail:focus {
    background: transparent;
    color: $primary;
    border: none;
}

StopAgentScreen,
QuitScreen,
SettingsScreen,
VulnerabilityDetailScreen {
    align: center middle;
}

#settings_dialog {
    width: 86;
    max-width: 95%;
    height: 90%;
    max-height: 40;
    padding: 1 2;
    border: round $border;
    background: $panel;
}

#settings_dialog Label {
    width: 100%;
    height: auto;
    color: $text;
}

#settings_title, #setting_name, #settings_save {
    text-style: bold;
}

#settings_path {
    height: 1;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#settings_filter {
    margin: 1 0;
}

#settings_list {
    height: 6;
    padding: 0;
    border: solid $border;
    background: $panel;
    color: $text;
}

#settings_list > .option-list--option-highlighted {
    color: $text;
    background: $panel-lighten-2;
    text-style: bold reverse;
}

#settings_list > .option-list--option-disabled {
    color: $text;
}

#settings_editor {
    height: 1fr;
    min-height: 3;
    margin: 1 0;
}

#settings_dialog Input:focus {
    border: tall $primary;
}

#settings_dialog Input > .input--placeholder {
    color: $text;
}

#settings_dialog #settings_error {
    color: $text-error;
    max-height: 4;
}

.settings_actions {
    height: 1;
}

.settings_actions Button {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    border: none;
    background: transparent;
    color: $text;
}

.settings_actions Button:hover, .settings_actions Button:focus {
    background: $panel-lighten-2;
    text-style: bold;
}

.settings_actions Button:focus {
    text-style: bold reverse;
}

SettingsScreen.compact #settings_dialog {
    padding: 0 1;
}

SettingsScreen.compact #settings_filter {
    height: 1;
    border: none;
    margin: 0;
}

SettingsScreen.compact #settings_list {
    height: 3;
}

SettingsScreen.compact #settings_editor {
    margin: 0;
}

SettingsScreen.compact #settings_pending {
    display: none;
}

SettingsScreen.compact #settings_destination {
    display: none;
}
