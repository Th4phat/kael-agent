{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Kael",
  "colors": {
    "primary": "#000000",
    "light": "#ffffff",
    "dark": "#000000"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Usage",
            "pages": ["usage/cli", "usage/scan-modes", "usage/instructions"]
          },
          {
            "group": "LLM Providers",
            "pages": [
              "llm-providers/overview",
              "llm-providers/openai",
              "llm-providers/anthropic",
              "llm-providers/openrouter",
              "llm-providers/vertex",
              "llm-providers/bedrock",
              "llm-providers/azure",
              "llm-providers/novita",
              "llm-providers/local"
            ]
          },
          {
            "group": "Integrations",
            "pages": ["integrations/github-actions", "integrations/ci-cd"]
          },
          {
            "group": "Tools",
            "pages": [
              "tools/overview",
              "tools/browser",
              "tools/proxy",
              "tools/terminal",
              "tools/sandbox"
            ]
          },
          {
            "group": "Advanced",
            "pages": ["advanced/configuration", "advanced/skills", "contributing"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/Th4phat/kael-agent",
          "icon": "github"
        },
        {
          "anchor": "Discussions",
          "href": "https://github.com/Th4phat/kael-agent/discussions",
          "icon": "comments"
        }
      ]
    }
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "View source",
      "href": "https://github.com/Th4phat/kael-agent"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Th4phat/kael-agent"
    }
  },
  "fonts": {
    "family": "Geist",
    "heading": {"family": "Geist"},
    "body": {"family": "Geist"}
  },
  "appearance": {"default": "dark"},
  "description": "Source documentation for the Kael security agent",
  "background": {"decoration": "grid"}
}
